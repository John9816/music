<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pageBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingHeader"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:minHeight="?attr/actionBarSize"
            app:contentScrim="?attr/pageBackground"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimAnimationDuration="200"
            app:scrimVisibleHeightTrigger="100dp"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false">

            <FrameLayout
                android:id="@+id/headerBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7">

                <ImageView
                    android:id="@+id/ivHeaderBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_header_default" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_collection_header_scrim" />
            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/expandedHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="72dp"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_m"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.45">

                <TextView
                    android:id="@+id/tvHeaderEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/downloads_header_eyebrow"
                    android:textAppearance="@style/TextAppearance.MusicPlayer.Eyebrow"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/headerCoverContainer"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginTop="@dimen/spacing_s"
                    app:cardBackgroundColor="?attr/surfaceColor"
                    app:cardCornerRadius="@dimen/playlist_cover_radius"
                    app:cardElevation="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHeaderEyebrow"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivHeaderCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/downloads_title"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music_note_24"
                        app:tint="?attr/brandPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/downloads_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/tvHeaderSubtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/headerCoverContainer"
                    app:layout_constraintTop_toTopOf="@id/headerCoverContainer"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:alpha="0.9"
                    app:layout_constraintBottom_toTopOf="@id/tvStorageHint"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/headerCoverContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

                <TextView
                    android:id="@+id/tvStorageHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:alpha="0.75"
                    app:layout_constraintBottom_toBottomOf="@id/headerCoverContainer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/headerCoverContainer"
                    app:layout_constraintTop_toBottomOf="@id/tvHeaderSubtitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:menu="@menu/menu_downloads"
                app:navigationContentDescription="@string/content_desc_back"
                app:navigationIcon="@drawable/ic_arrow_back_24"
                app:navigationIconTint="@color/white"
                app:title=""
                app:titleTextColor="?attr/textPrimary" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/pageBackground"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_s"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/downloads_search_hint"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_m"
                app:boxCornerRadiusBottomStart="@dimen/radius_m"
                app:boxCornerRadiusTopEnd="@dimen/radius_m"
                app:boxCornerRadiusTopStart="@dimen/radius_m"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/actionRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/pageBackground"
            android:paddingStart="@dimen/spacing_m"
            android:paddingEnd="@dimen/spacing_m"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayAll"
                style="@style/Widget.MusicPlayer.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:contentDescription="@string/action_play_all"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:text="@string/action_play_all"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radius_m"
                app:icon="@drawable/ic_play_24"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="?attr/textPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="?attr/dividerColor"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShuffle"
                style="@style/Widget.MusicPlayer.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:contentDescription="@string/downloads_shuffle"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:text="@string/downloads_shuffle"
                android:textColor="?attr/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radius_m"
                app:icon="@drawable/ic_shuffle_24"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="?attr/textPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnPlayAll"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="?attr/dividerColor"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tvCountChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_duration_chip"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_s"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_s"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/brandPrimaryDark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/downloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_m"
            android:layout_marginBottom="@dimen/spacing_s"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/surfaceAltColor"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDownloadLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/downloads_progress_label"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/textPrimary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDownloadProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="?attr/brandPrimary" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/downloadProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:max="100"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_l"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="?attr/surfaceAltColor"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note_24"
                app:tint="?attr/brandPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/downloads_empty"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/textPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/downloads_empty_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/textSecondary" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
